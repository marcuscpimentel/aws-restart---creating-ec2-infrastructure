aws_region             = "us-east-1"
project_name           = "ec2-lab"
instance_type          = "t3.micro"
root_volume_size       = 8
allow_http             = false
http_cidr              = "0.0.0.0/0"
termination_protection = true

# Se estiver no ambiente do curso, use a região e uma sub-rede pública da Lab VPC.
# existing_subnet_id = "subnet-0123456789abcdef0"

# AMI própria deve ser Amazon Linux 2023 x86_64 na mesma região.
# ami_id = "ami-0123456789abcdef0"
